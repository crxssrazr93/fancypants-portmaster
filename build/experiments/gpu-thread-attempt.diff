index c3d53d2d..8802e0a2 100644
--- a/render/src/lib.rs
+++ b/render/src/lib.rs
@@ -25,3 +25,51 @@ pub mod quality;
 pub mod tessellator;
 
 pub use pixel_bender;
+
+/// Frame time breakdown for the PortMaster port's RUFFLE_FPS_LOG output.
+pub mod port_stats {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::Instant;
+
+    /// Nanoseconds spent in queue submissions (where the GL backend makes its driver calls).
+    pub static SUBMIT_NS: AtomicU64 = AtomicU64::new(0);
+    pub static SUBMITS: AtomicU64 = AtomicU64::new(0);
+    /// Nanoseconds spent processing Stage3D commands, including their submissions.
+    pub static CONTEXT3D_NS: AtomicU64 = AtomicU64::new(0);
+
+    pub fn time<T>(counter: &AtomicU64, f: impl FnOnce() -> T) -> T {
+        let t0 = Instant::now();
+        let r = f();
+        counter.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        r
+    }
+
+    pub fn submit<T>(f: impl FnOnce() -> T) -> T {
+        SUBMITS.fetch_add(1, Ordering::Relaxed);
+        time(&SUBMIT_NS, f)
+    }
+
+    /// Adds the time until it is dropped to CONTEXT3D_NS.
+    pub struct Context3DTimer(Instant);
+
+    impl Context3DTimer {
+        pub fn new() -> Self {
+            Self(Instant::now())
+        }
+    }
+
+    impl Drop for Context3DTimer {
+        fn drop(&mut self) {
+            CONTEXT3D_NS.fetch_add(self.0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        }
+    }
+
+    /// Returns and resets (submit ms, submits, Stage3D ms).
+    pub fn take() -> (f64, u64, f64) {
+        (
+            SUBMIT_NS.swap(0, Ordering::Relaxed) as f64 / 1e6,
+            SUBMITS.swap(0, Ordering::Relaxed),
+            CONTEXT3D_NS.swap(0, Ordering::Relaxed) as f64 / 1e6,
+        )
+    }
+}
